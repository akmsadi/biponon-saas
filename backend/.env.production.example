# Production settings for shared cPanel hosting. Copy to .env on the server
# (~/biponon/backend/.env), fill in every CHANGE_ME, then run `php artisan key:generate`.
# Never commit the real file.

APP_NAME=Biponon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily log files in storage/logs, kept 14 days; only errors and worse.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL database created in cPanel → MySQL Databases (names carry the cPanel user prefix).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# Folder holding mysqldump for backups, if `which mysqldump` finds nothing (e.g. /usr/bin).
DB_DUMP_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over HTTPS: keep Force HTTPS Redirect on for the domain.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Drained every minute by the cron job running `php artisan schedule:run`.
QUEUE_CONNECTION=database
CACHE_STORE=database

# No mail provider yet: emails are written to the log and invitation links are copied by hand.
# To send real mail, create e.g. no-reply@yourdomain in cPanel → Email Accounts and use its
# "Connect Devices" settings:
#   MAIL_MAILER=smtp, MAIL_SCHEME=smtps, MAIL_HOST=mail.yourdomain, MAIL_PORT=465,
#   MAIL_USERNAME=no-reply@yourdomain, MAIL_PASSWORD=...
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@CHANGE_ME.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared hosting can't run the Node server that server-side rendering needs; pages render in the browser.
INERTIA_SSR_ENABLED=false

# Joining is invitation-only.
REGISTRATION_ENABLED=false

# Nightly database backups land in storage/app/private/biponon; failures are emailed here.
BACKUP_NAME=biponon
BACKUP_NOTIFICATION_EMAIL=CHANGE_ME@example.com
# Password that locks each backup zip (AES-256). Keep a copy somewhere safe: without it the backups can't be opened.
BACKUP_ARCHIVE_PASSWORD=

# Each backup zip is also copied to this Dropbox folder. Leave the three keys empty to skip.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_BACKUP_FOLDER=/saas_database
